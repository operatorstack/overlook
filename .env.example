# Copy to .env and adjust (see docs/dev.md)
# cp .env.example .env

# HTTP port for the server
PORT=3000

# production | development (affects /api/info build.environment)
NODE_ENV=development

# CLI scan command default base URL (npm run cli -- scan …)
BASE_URL=http://127.0.0.1:3000

# Optional — shown on dashboard and GET /api/info → build (first non-empty wins per field)
# GIT_COMMIT_SHA=
# VERCEL_GIT_COMMIT_SHA=
# BUILD_ID=

# --- Future: Anthropic LLM (coding / analysis agent) ---
# API key (secret — never commit). Host runtime reads this when you wire the client.
# ANTHROPIC_API_KEY=
#
# Optional model id (default claude-3-5-haiku-20241022)
# ANTHROPIC_MODEL=
#
# Base URL for the API. Use either name; ANTHROPIC_URL wins if both are set.
# Default if unset: https://api.anthropic.com
# ANTHROPIC_URL=https://api.anthropic.com
# ANTHROPIC_BASE_URL=https://api.anthropic.com
